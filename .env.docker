# DO NOT commit this file after filling in real values
# Copy to .env.docker.local and use: docker compose --env-file .env.docker.local up
# Docker Compose environment for Jotter.
#
# Copy this file, then replace every REPLACE_THIS placeholder before running
# `docker compose up`. Values here are read literally by Compose's env_file,
# so ${VAR} references are NOT expanded here -- write the real value twice
# wherever the MySQL password appears (MYSQL_ROOT_PASSWORD, DATABASE_URL and
# SYNC_DATABASE_URL).

SECRET_KEY=REPLACE_THIS_MIN_32_CHARS_BEFORE_USE
DATABASE_URL=mysql+aiomysql://root:REPLACE_THIS_TOO@db:3306/jotter_db
DEBUG=False
FRONTEND_URL=http://localhost
MYSQL_ROOT_PASSWORD=REPLACE_THIS_TOO
